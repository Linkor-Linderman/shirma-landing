# Серверный ключ Loops. Не используйте NEXT_PUBLIC_ и не коммитьте значение.
LOOPS_API_KEY=

# Необязательно. Ящик с plus-addressing: Telegram-заявке добавится адрес name+tg_user@domain,
# чтобы контакт было проще найти в аудитории Loops. Без него Telegram уходит с userId.
LOOPS_INBOX_EMAIL=

# true — индексация разрешена и форма может отправлять заявки (если задан LOOPS_API_KEY).
# Любое другое значение или пусто — закрытый режим. После смены пересоберите проект.
SITE_PUBLIC=false

# Номер счётчика Яндекс Метрики. Пусто — события никуда не уходят.
NEXT_PUBLIC_YM_ID=
